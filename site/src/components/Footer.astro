---
import Logo from './Logo.astro';
import { REPO } from '../dados';
const year = new Date().getFullYear();
---

<footer>
  <div class="container row">
    <div>
      <Logo />
      <p>Leitor de PDF leve com assinatura digital ICP-Brasil.</p>
    </div>
    <small>© {year} Nukt Ltda · <a href={REPO} target="_blank" rel="noopener">Código-fonte no GitHub</a></small>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding: 40px 0; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  p { color: var(--muted); margin-top: 8px; font-size: .92rem; }
  small { color: var(--muted); }
  small a:hover { color: var(--red-600); }
</style>
