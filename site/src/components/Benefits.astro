---
import { DOWNLOAD } from '../dados';
const stats = [
  { v: '1 clique', l: 'para copiar qualquer texto do PDF' },
  { v: '0', l: 'permissões de administrador para instalar' },
  { v: '100%', l: 'local: seus PDFs não saem do computador' },
];
const list = [
  'Assine contratos, ofícios e declarações com validade jurídica ICP-Brasil',
  'Confira assinaturas recebidas antes de aceitar um documento',
  'Copie dados de certidões, notas e boletos sem redigitar',
  'Atualizações automáticas, sem depender de ninguém da TI',
];
---

<section id="beneficios">
  <div class="container wrap">
    <div class="text">
      <span class="eyebrow">Benefícios</span>
      <h2>Mais agilidade no dia a dia com documentos</h2>
      <ul>
        {list.map((l) => <li><span>✓</span>{l}</li>)}
      </ul>
      <a class="btn btn-primary" href={DOWNLOAD} data-download>Baixar o nupdf</a>
    </div>
    <div class="stats">
      {stats.map((s) => (
        <div class="stat"><b>{s.v}</b><span>{s.l}</span></div>
      ))}
    </div>
  </div>
</section>

<style>
  .wrap { display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center; }
  h2 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 800; }
  ul { list-style: none; padding: 0; margin: 28px 0 32px; display: grid; gap: 14px; }
  li { display: flex; gap: 12px; color: var(--ink-2); font-size: 1.02rem; }
  li span { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--red-100); color: var(--red-700); display: grid; place-items: center; font-size: .8rem; font-weight: 800; margin-top: 2px; }
  .stats { display: grid; gap: 16px; padding: 32px; border-radius: 24px; background: linear-gradient(145deg, var(--red-500), var(--red-700)); color: #fff; box-shadow: var(--shadow-red); }
  .stat { display: flex; align-items: baseline; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.2); }
  .stat:last-child { border-bottom: none; }
  .stat b { font-size: 2.2rem; font-weight: 800; min-width: 150px; letter-spacing: -0.03em; white-space: nowrap; }
  .stat span { opacity: .9; }
  @media (max-width: 860px) { .wrap { grid-template-columns: 1fr; gap: 40px; } }
  @media (max-width: 480px) { .stat { flex-direction: column; gap: 2px; } .stat b { min-width: 0; } }
</style>
