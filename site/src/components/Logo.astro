---
// "nupdf" em Comfortaa ("nu" na cor do texto, "pdf" no vermelho da marca), só o
// texto - o mesmo padrão dos logos nukt, nusign, qiponto e flow.
const { light = false } = Astro.props;
---

<span class:list={['logo', { light }]} role="img" aria-label="nupdf">nu<b>pdf</b></span>

<style>
  .logo { display: inline-block; font-family: "Comfortaa", ui-rounded, system-ui, sans-serif; font-weight: 700; font-size: 1.75rem; line-height: 1; letter-spacing: 0; color: var(--ink); }
  .logo b { font-weight: 700; color: var(--red-500); }
  .logo.light { color: #fff; }
  .logo.light b { color: var(--red-100); }
</style>
