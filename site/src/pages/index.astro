---
// Página de apresentação do NuPDF.
// O download aponta para "releases/latest/download/Instalador.exe": o GitHub
// redireciona sempre para o Instalador.exe da release mais recente (gerado
// pelo workflow .github/workflows/versao.yml), sem precisar republicar o site.
const REPO = "https://github.com/hudson-santos/nupdf";
const DOWNLOAD = `${REPO}/releases/latest/download/Instalador.exe`;
const API_RELEASE = "https://api.github.com/repos/hudson-santos/nupdf/releases/latest";

const recursos = [
  {
    titulo: "Leia sem peso",
    texto: "Abre rápido, com abas, miniaturas, busca e zoom. Sem as dezenas de ferramentas que ninguém usa.",
    icone: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  },
  {
    titulo: "Copie dados com precisão",
    texto: "Seleção de texto na ordem em que aparece na página: palavra, linha ou área. Ctrl+C e pronto.",
    icone: '<rect x="8" y="8" width="14" height="14" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
  },
  {
    titulo: "Assine com ICP-Brasil",
    texto: "Assinatura digital PAdES com o certificado instalado no Windows, visível ou invisível na página.",
    icone: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-K3WNBF02JT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-K3WNBF02JT');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NuPDF - Leitor de PDF Leve com Assinatura Digital ICP-Brasil</title>
    <meta
      name="description"
      content="Leia PDFs, Copie Dados e Assine Digitalmente com Certificado ICP-Brasil. Leitor de PDF leve para Windows."
    />
    <meta name="theme-color" content="#E5484D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/GoogleSans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content="NuPDF" />
    <meta property="og:description" content="Leia PDFs, Copie Dados e Assine Digitalmente com Certificado ICP-Brasil." />
    <meta property="og:image" content={new URL("/img/nupdf-app.png", Astro.site)} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="topo">
      <a class="marca" href="/">
        <img src="/favicon.svg" alt="" width="28" height="28" />
        <span>Nu<b>PDF</b></span>
      </a>
      <a class="link-topo" href={REPO} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        GitHub
      </a>
    </header>

    <main>
      <section class="hero">
        <img class="logo" src="/favicon.svg" alt="Logo do NuPDF" width="72" height="72" />
        <h1>NuPDF</h1>
        <p class="sub">Leia PDFs, Copie Dados e Assine Digitalmente com Certificado <span class="inteiro">ICP-Brasil</span></p>

        <div class="acoes">
          <a class="botao primario" href={DOWNLOAD} data-download>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Baixar para Windows
          </a>
          <a class="botao secundario" href={REPO} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
            Ver no GitHub
          </a>
        </div>
        <p class="meta" data-meta>Windows 10 e 11 · 64 bits · Instala em C:\NuPDF sem administrador</p>
      </section>

      <section class="recursos" aria-label="Recursos">
        {recursos.map((r) => (
          <article class="cartao">
            <span class="icone">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icone} />
            </span>
            <h2>{r.titulo}</h2>
            <p>{r.texto}</p>
          </article>
        ))}
      </section>

      <section class="instalar">
        <h2>Instalação em três passos</h2>
        <ol>
          <li><span>1</span><p>Baixe o <b>Instalador.exe</b> da versão mais recente.</p></li>
          <li><span>2</span><p>Execute e aguarde. Não é preciso ser administrador.</p></li>
          <li><span>3</span><p>Abra pelo atalho <b>NuPDF</b> na Área de Trabalho.</p></li>
        </ol>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Nukt Ltda · <a href={REPO} target="_blank" rel="noopener">Código-fonte no GitHub</a></p>
    </footer>

    <script is:inline define:vars={{ API_RELEASE }}>
      // Mostra a versão e o tamanho da última release (API pública do GitHub).
      // Se falhar (sem internet, limite de requisições ou ainda sem release),
      // a página continua com o texto padrão e o link de download funciona igual.
      fetch(API_RELEASE, { headers: { Accept: "application/vnd.github+json" } })
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((rel) => {
          const exe = (rel.assets || []).find((a) => a.name === "Instalador.exe");
          if (!exe) return;
          const mb = (exe.size / 1048576).toFixed(1).replace(".", ",");
          const data = new Date(rel.published_at).toLocaleDateString("pt-BR");
          document.querySelector("[data-meta]").textContent =
            `Versão ${rel.tag_name} · ${data} · ${mb} MB · Windows 10 e 11 (64 bits)`;
          document.querySelector("[data-download]").href = exe.browser_download_url;
        })
        .catch(() => {});
    </script>

    <style is:global>
      @font-face {
        font-family: "Google Sans";
        src: url("/fonts/GoogleSans-latin.woff2") format("woff2");
        font-weight: 400 700;
        font-display: swap;
      }
      :root {
        --fundo: #f6f6f8;
        --superficie: #ffffff;
        --texto: #1d1f24;
        --texto2: #5d6068;
        --texto3: #8b8e96;
        --borda: #e6e6eb;
        --destaque: #e5484d;
        --destaque-hover: #d63e43;
        --destaque-suave: #fdecec;
        --sombra: 0 24px 60px -24px rgba(20, 22, 30, 0.25);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fundo: #151619;
          --superficie: #1f2023;
          --texto: #e7e7ea;
          --texto2: #a1a3aa;
          --texto3: #7a7d85;
          --borda: #2e3034;
          --destaque-suave: #3b2023;
          --sombra: 0 24px 60px -24px rgba(0, 0, 0, 0.7);
        }
      }
      * { box-sizing: border-box; margin: 0; }
      html {
        -webkit-text-size-adjust: 100%;
        /* sem barra de rolagem visível - a página continua rolando
           normalmente (roda do mouse, toque, teclado) */
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      html::-webkit-scrollbar { display: none; }
      body {
        font-family: "Google Sans", "Segoe UI", system-ui, sans-serif;
        background: var(--fundo);
        color: var(--texto);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      img { max-width: 100%; height: auto; display: block; }
    </style>

    <style>
      .topo {
        max-width: 1120px;
        margin: 0 auto;
        padding: 20px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; font-size: 19px; font-weight: 700; }
      .marca b { color: var(--destaque); }
      .link-topo {
        display: inline-flex; align-items: center; gap: 8px;
        text-decoration: none; color: var(--texto2); font-size: 14px;
        padding: 8px 12px; border-radius: 10px;
      }
      .link-topo:hover { background: var(--superficie); color: var(--texto); }

      main { max-width: 1120px; margin: 0 auto; padding: 0 20px; }

      .hero { text-align: center; padding: 40px 0 24px; }
      .logo { margin: 0 auto 18px; filter: drop-shadow(0 10px 24px rgba(229, 72, 77, 0.35)); }
      h1 { font-size: clamp(40px, 7vw, 60px); line-height: 1.05; letter-spacing: -1px; font-weight: 700; }
      .sub { margin: 14px auto 0; max-width: 760px; font-size: clamp(17px, 2.4vw, 20px); color: var(--texto2); }

      .inteiro { white-space: nowrap; }
      .acoes { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }
      .botao {
        display: inline-flex; align-items: center; gap: 10px;
        padding: 14px 24px; border-radius: 12px;
        font-size: 16px; font-weight: 600; text-decoration: none;
        transition: background 0.15s, transform 0.15s, border-color 0.15s;
      }
      .botao:hover { transform: translateY(-1px); }
      .botao:focus-visible { outline: 3px solid var(--destaque); outline-offset: 3px; }
      .primario { background: var(--destaque); color: #fff; box-shadow: 0 10px 24px -10px rgba(229, 72, 77, 0.7); }
      .primario:hover { background: var(--destaque-hover); }
      .secundario { background: var(--superficie); color: var(--texto); border: 1px solid var(--borda); }
      .secundario:hover { border-color: var(--texto3); }
      .meta { margin-top: 14px; font-size: 13px; color: var(--texto3); }


      .recursos {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin: 72px 0 0;
      }
      .cartao {
        background: var(--superficie);
        border: 1px solid var(--borda);
        border-radius: 16px;
        padding: 24px;
      }
      .icone {
        display: inline-grid; place-items: center;
        width: 44px; height: 44px; border-radius: 12px;
        background: var(--destaque-suave); color: var(--destaque);
      }
      .cartao h2 { margin-top: 16px; font-size: 18px; font-weight: 600; }
      .cartao p { margin-top: 6px; color: var(--texto2); font-size: 15px; }

      .instalar { margin: 72px 0 0; text-align: center; }
      .instalar h2 { font-size: 24px; font-weight: 700; }
      .instalar ol {
        list-style: none; padding: 0;
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
        margin-top: 24px; text-align: left;
      }
      .instalar li {
        display: flex; gap: 12px; align-items: flex-start;
        background: var(--superficie); border: 1px solid var(--borda);
        border-radius: 14px; padding: 18px; color: var(--texto2); font-size: 15px;
      }
      .instalar li b { color: var(--texto); }
      .instalar li span {
        flex: none; display: grid; place-items: center;
        width: 26px; height: 26px; border-radius: 50%;
        background: var(--destaque); color: #fff; font-size: 13px; font-weight: 700;
      }

      footer { margin-top: 80px; padding: 28px 20px 36px; border-top: 1px solid var(--borda); text-align: center; }
      footer p { font-size: 13px; color: var(--texto3); }
      footer a { color: var(--texto2); }

      @media (max-width: 820px) {
        .recursos, .instalar ol { grid-template-columns: 1fr; }
        .hero { padding-top: 24px; }
      }
      @media (max-width: 480px) {
        .acoes { flex-direction: column; align-items: stretch; }
        .botao { justify-content: center; }
      }
    </style>
  </body>
</html>
