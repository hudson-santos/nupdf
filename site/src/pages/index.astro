---
// Página de apresentação do NuPDF - mesmo modelo das páginas Asste, Kippe, QiPonto
// e Nukt (componentes em src/components, estilos em src/styles/global.css).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Benefits from '../components/Benefits.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import { API_RELEASE } from '../dados';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Features />
    <HowItWorks />
    <Benefits />
    <Faq />
    <Cta />
  </main>
  <Footer />

  <script is:inline define:vars={{ API_RELEASE }}>
    // Versão e tamanho da última release (API pública do GitHub) e link direto do
    // instalador. Se falhar (sem internet, limite de requisições), a página continua
    // com o texto padrão e os botões baixam pelo link "latest" do mesmo jeito.
    fetch(API_RELEASE, { headers: { Accept: "application/vnd.github+json" } })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((rel) => {
        const exe = (rel.assets || []).find((a) => a.name === "Instalador.exe");
        if (!exe) return;
        const mb = (exe.size / 1048576).toFixed(1).replace(".", ",");
        const data = new Date(rel.published_at).toLocaleDateString("pt-BR");
        document.querySelectorAll("[data-meta]").forEach((el) => {
          el.textContent = `Versão ${rel.tag_name} · ${data} · ${mb} MB · Windows 10 e 11 (64 bits)`;
        });
        document.querySelectorAll("[data-download]").forEach((a) => { a.href = exe.browser_download_url; });
      })
      .catch(() => {});
  </script>
</Layout>
